<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>ForemanTest</AssemblyTitle>
    <Product>ForemanTest</Product>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\Foreman\Presets\Factorio 2.0 Vanilla.pjson" Link="Presets\Factorio 2.0 Vanilla.pjson" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Foreman\Presets\Factorio 2.0 Vanilla.dat" Link="Presets\Factorio 2.0 Vanilla.dat" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Foreman\Presets\Factorio 2.0 Vanilla.json" Link="Presets\Factorio 2.0 Vanilla.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\Foreman\Presets\Factorio 2.0 Vanilla.json')" />
    <None Include="..\Foreman\Presets\Factorio 2.0 Space Age.pjson" Link="Presets\Factorio 2.0 Space Age.pjson" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Foreman\Presets\Factorio 2.0 Space Age.dat" Link="Presets\Factorio 2.0 Space Age.dat" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Foreman\Presets\Factorio 2.0 Space Age.json" Link="Presets\Factorio 2.0 Space Age.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\Foreman\Presets\Factorio 2.0 Space Age.json')" />
    <None Include="assets\Flowchart.fjson" CopyToOutputDirectory="PreserveNewest" Link="assets\Flowchart.fjson" />
    <None Include="assets\Seablock chart.fjson" CopyToOutputDirectory="PreserveNewest" Link="assets\Seablock chart.fjson" />
    <None Include="assets\Factorio 2.0 Pyanodon.pjson.zst" CopyToOutputDirectory="PreserveNewest" Link="assets\Factorio 2.0 Pyanodon.pjson.zst" />
    <None Include="assets\Factorio 2.0 SEKrastorio.pjson.zst" CopyToOutputDirectory="PreserveNewest" Link="assets\Factorio 2.0 SEKrastorio.pjson.zst" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Foreman\Foreman.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Google.OrTools" Version="9.15.6755" />
    <PackageReference Include="Google.Protobuf" Version="3.34.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.2" />
  </ItemGroup>
</Project>
